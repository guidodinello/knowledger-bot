TELEGRAM_BOT_TOKEN=your-telegram-bot-token
CLAUDE_SESSION_TOKEN=sk-ant-sid01-...
ALLOWED_USER_IDS=123456789,987654321
PROJECT_WHITELIST=proj_name1,proj 2,proj3

# Optional: HTTP endpoint for automated token updates (e.g. from a Chrome extension).
# TOKEN_UPDATE_SECRET is required when TOKEN_SERVER_PORT is set; startup will fail without it.
# TOKEN_SERVER_PORT enables the server; leave unset to disable it entirely.
TOKEN_UPDATE_SECRET=your-secret-here
TOKEN_SERVER_PORT=8080

# Optional: restrict CORS to a specific origin (e.g. chrome-extension://<id>).
# Defaults to * (any origin) if unset.
# CORS_ALLOWED_ORIGIN=chrome-extension://<your-extension-id>

# Optional: only accept tokens belonging to this Claude org UUID.
# Find it in the claude.ai URL: /api/organizations/<uuid>/...
# If unset, any valid token is accepted (multi-account friendly).
PERSONAL_ORG_ID=

# Optional: auto-transcript poller. Set AUTO_TRANSCRIPT_PROJECT to a Claude project NAME
# to enable it; leave unset to disable the poller entirely. Channels to watch are listed
# in channels.json (see CHANNELS_PATH). New videos are transcribed 24h after publishing
# and uploaded to that project.
# AUTO_TRANSCRIPT_PROJECT=My Review Project
# CHANNELS_PATH=channels.json
# POLL_INTERVAL_SECONDS=3600
